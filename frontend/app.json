{
  "expo": {
    "name": "Pahlawan Nusantara AR",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pahlawanar",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi memerlukan kamera untuk memindai QR Code pahlawan dan menampilkan AR.",
        "NSMicrophoneUsageDescription": "Akses microphone tidak diperlukan."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#CE1126"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "package": "com.rifqi20.frontend"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#CE1126"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi memerlukan kamera untuk memindai QR Code pahlawan dan menampilkan AR."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Aplikasi membutuhkan izin galeri untuk menyimpan QR Code.",
          "savePhotosPermission": "Aplikasi membutuhkan izin galeri untuk menyimpan QR Code.",
          "granularPermissions": [
            "audio",
            "photo"
          ]
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "52cb09d4-0371-4dd4-841b-74f5d55c55a3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "pahlawannasional",
    "updates": {
      "url": "https://u.expo.dev/52cb09d4-0371-4dd4-841b-74f5d55c55a3"
    }
  }
}
